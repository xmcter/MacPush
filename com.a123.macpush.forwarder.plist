<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.a123.macpush.forwarder</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <!-- Replace with the actual path to your forwarder.py -->
        <string>/path/to/MacPush/forwarder.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <!-- Replace with the actual path to your MacPush directory -->
    <string>/path/to/MacPush</string>
    <key>StandardOutPath</key>
    <string>/tmp/macpush_forwarder.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/macpush_forwarder.log</string>
</dict>
</plist>
